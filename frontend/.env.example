# Supabase project that hosts the agentops schema.
# Both values are safe to publish: the publishable key only grants what RLS allows.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_SCHEMA=agentops

# Optional: point the agent-facing FastAPI service somewhere other than localhost.
# VITE_API_BASE=http://localhost:8000/api/v1

# The AI DevOps control plane (aidevops/). The shell calls it with the Supabase
# session token; it never reads the control plane's tables directly.
# VITE_CONTROL_PLANE_URL=http://localhost:8010
