# The FastAPI service is the agent-facing API. The browser talks to Supabase
# directly, so these values are only needed for /stream and /webhooks.

# Same project the frontend uses.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SCHEMA=agentops

# Server-side only. Required for POST /api/v1/webhooks/alerts, which writes on
# behalf of a monitoring system that has no user session. Never expose this to
# a browser and never commit it.
SUPABASE_SERVICE_KEY=

# Browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How often the SSE stream polls for incident changes.
STREAM_INTERVAL_SECONDS=3
