# Control plane -- local development
#
# Copy to aidevops/.env (gitignored). `Settings.from_env` reads this file when
# the variable is not already in the environment, so the "control-plane" launch
# configuration needs no shell exports.

# The DATABASE_URL is a real credential. It belongs here or in Key Vault, never in
# the repo. Supabase dashboard: Project Settings > Database > Connection string > URI.
# Supabase project "DataOps" (tqqfibmssdlegrakvlxs, us-west-2, Postgres 17)
DATABASE_URL=postgresql://postgres:<password>@db.tqqfibmssdlegrakvlxs.supabase.co:5432/postgres

# The app connects with the above credential but immediately drops into the
# adp_app role per transaction (ADR-0001 Amendment 1). Nothing here grants
# BYPASSRLS to the query path.

# Portal identity (ADR-0005): the unified shell sends its Supabase session token,
# and the control plane asks Supabase Auth who it belongs to. Same values as
# frontend/.env.local; both are safe to publish.
SUPABASE_URL=https://tqqfibmssdlegrakvlxs.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Which browser origins may call the API. Defaults to the Vite dev ports.
ADP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

ADP_ENVIRONMENT=dev
ADP_TENANT_ID=acme
ADP_DATABRICKS_HOST=https://adb-<workspace>.azuredatabricks.net

# Dev only. A signed-in user with no row in public.tenant_members is placed in
# this tenant as an approver, so a fresh clone has something to look at. Ignored
# outside ADP_ENVIRONMENT=dev; there an unmapped account is a 403.
ADP_DEV_TENANT=acme

# Dev only. Ignored outside ADP_ENVIRONMENT=dev (see auth/credentials.py).
ADP_ALLOW_DEVELOPER_CREDENTIALS=1
